    <!-- Home -->
    <string name="tell">What did you dream?</string>
    <string name="empty_title">The album is empty</string>
    <string name="empty_sub">Tomorrow morning, before you even sit up, tell the app what you dreamt. It will become a page.</string>
    <string name="rehearse_title">Read the new ending again</string>
    <string name="rehearse_sub">Before sleep, run the rewritten dream through your head once. That’s how the old one loosens its grip.</string>
    <string name="returning_title">“%1$s” is back</string>
    <plurals name="returning_sub">
        <item quantity="one">In %d dream already. Keep them in the cast?</item>
