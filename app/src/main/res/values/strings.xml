    <string-array name="bed_stages">
        <item>The bed is fast asleep.</item>
        <item>The bed has stirred and grown little legs.</item>
        <item>The bed stands up on its legs.</item>
        <item>The bed walks out into your dreamland.</item>
        <item>The bed strides over rooftops on long legs.</item>
    </string-array>

